act'\n\nimport {\n  Button,\n  FormControl,\n  // FormControlLabel,\n  FormGroup,\n  InputLabel,\n  MenuItem,\n  Select,\n  // Switch,\n  Typography\n} from '@material-ui/core'\n\n// import { withStyles } from '@material-ui/core/styles';\n// import { green } from '@material-ui/core/colors';\n// import Grid from '@material-ui/core/Grid';\n\n\nimport VisibilityIcon from '@material-ui/icons/Visibility'\nimport VisibilityOffIcon from '@material-ui/icons/VisibilityOff'\n\nimport {OptionsContext} from '../contexts/OptionsContext'\nimport {ChartContext} from '../contexts/ChartContext'\nimport {CurrentContext} from '../contexts/CurrentContext'\n\nimport '../styles/Options.scss'\n\n// const DataSwitch = withStyles({\n//   switchBase: {\n//     transition: 'all .5s',\n//     color: green[500],\n//     '&$checked': {\n//       color: green[500],\n//     },\n//     '&$checked + $track': {\n//       backgroundColor: green[500],\n//     },\n//   },\n//   checked: {},\n//   track: {backgroundColor: green[500]},\n// })(Switch);\n\nfunction Options() {\n  // const [vaScope, setVAScope] = useState(false);\n\n  const {options, setOptions} = useContext(OptionsContext)\n  const {chart, setChart} = useContext(ChartContext)\n  const {current} = useContext(CurrentContext)\n\n  \n  const handleChange = (event, field) => {\n    let newOptions = {...options}\n    newOptions[field] = event.target.value\n    setOptions(newOptions)\n  }\n\n  // const handleToggle = (event) => {\n  //   // Also fly to new viewport and filter down data\n  //   setVAScope(event.target.checked);\n  // };\n\n  return (\n    <div id=\"options-cont\" className=\"card\">\n      <Typography variant=\"h5\" component = \"h2\">\n        Options\n      </Typography>\n      <FormGroup id=\"input-cont\">\n        <FormControl>\n          <InputLabel>\n            Return Period\n          </InputLabel>\n          <Select\n            displayEmpty\n            value={options['rp']}\n            onChange={event => handleChange(event, \"rp\")}\n          >\n            <MenuItem value={2}>2-year</MenuItem>\n            <MenuItem value={5}>5-year</MenuItem>\n            <MenuItem value={10}>10-year</MenuItem>\n            <MenuItem value={25}>25-year</MenuItem>\n            <MenuItem value={50}>50-year</MenuItem>\n            <MenuItem value={100}>100-year</MenuItem>\n          </Select>\n        </FormControl>\n        <FormControl>\n          <InputLabel shrink>\n            Emission Scenario\n          </InputLabel>\n          <Select\n            displayEmpty\n            value={options['emission']}\n            onChange={event => handleChange(event, \"emission\")}\n          >\n            <MenuItem value={8.5}>High RCP 8.5</MenuItem>\n            <MenuItem value={4.5}>Low RCP 4.5</MenuItem>\n          </Select>\n        </FormControl>\n        <FormControl>\n          <InputLabel>\n            Time Period\n          </InputLabel>\n          <Select\n            displayEmpty\n            value={options['tp']}\n            onChange={event => handleChange(event, \"tp\")}\n          >\n            <MenuItem value={\"2020-2070\"}>2020-2070</MenuItem>\n            <MenuItem value={\"2050-2100\"}>2050-2100</MenuItem>\n          </Select>\n        </FormControl>\n        <FormControl>\n          <InputLabel>\n            Area of Concern\n          </InputLabel>\n          <Select\n            displayEmpty\n            value={options['area']}\n            onChange={event => handleChange(event, \"area\")}\n          >\n            <MenuItem value={\"bay\"}>Chesapeake Bay Watershed</MenuItem>\n            <MenuItem value={\"virginia\"}>Virginia</MenuItem>\n          </Select>\n        </FormControl>\n        \n        {/* <div id=\"switch-container\"> */}\n          {/* <div className=\"switch-label\">Chesapeake Bay</div>\n          <FormControlLabel\n            control={\n              <Switch\n              checked={vaScope}\n              onChange={handleToggle}\n              name=\"scopeFilter\"\n              color=\"rgb(255, 0, 0)\"\n              />\n            }\n          />\n          <div className=\"switch-label\">Virginia</div> */}\n\n          {/* <Grid component=\"label\" container alignItems=\"center\" spacing={1}>\n            <Grid item><div className=\"switch-label\">Chesapeake Bay</div></Grid>\n            <Grid item>\n              <DataSwitch checked={vaScope} onChange={handleToggle} name=\"ScopeFilter\" />\n            </Grid>\n            <Grid item><div className=\"switch-label\">Virginia</div></Grid>\n          </Grid> */}\n        {/* </div> */}\n      </FormGroup>\n      <Button\n        id=\"chart-toggle\"\n        aria-label=\"toggle chart visibility\"\n        disabled={!current}\n        onClick={() => setChart(!chart)}\n        endIcon= {chart ? <VisibilityOffIcon/> : <VisibilityIcon/>}\n      >\n        {`Chart ${chart ? 'Off' : 'On'}`}\n      </Button>\n    </div>\n  )\n}\n\nexport default Options","/home/ben/Desktop/Chesapeake/src/contexts/CurrentContext.js",[],"/home/ben/Desktop/Chesapeake/src/contexts/ChartContext.js",[],"/home/ben/Desktop/Chesapeake/src/contexts/OptionsContext.js",[],"/home/ben/Desktop/Chesapeake/src/components/Header.js",["71","72","73","74"],"/home/ben/Desktop/Chesapeake/src/components/Footer.js",[],"/home/ben/Desktop/Chesapeake/src/components/CustomModal.js",["75"],{"ruleId":"76","severity":1,"message":"77","line":1,"column":19,"nodeType":"78","messageId":"79","endLine":1,"endColumn":29},{"ruleId":"76","severity":1,"message":"80","line":1,"column":31,"nodeType":"78","messageId":"79","endLine":1,"endColumn":40},{"ruleId":"76","severity":1,"message":"81","line":17,"column":9,"nodeType":"78","messageId":"79","endLine":17,"endColumn":17},{"ruleId":"76","severity":1,"message":"82","line":17,"column":19,"nodeType":"78","messageId":"79","endLine":17,"endColumn":27},{"ruleId":"83","severity":1,"message":"84","line":199,"column":6,"nodeType":"85","endLine":199,"endColumn":12,"suggestions":"86"},{"ruleId":"