fixableWarningCount":0},"/home/ben/Desktop/Chesapeake/src/components/CustomModal.js",["68"],"import React, { useState, useEffect } from 'react';\nimport { Modal } from '@material-ui/core';\nimport { makeStyles } from '@material-ui/core/styles';\n\nfunction getModalStyle() {\n  return {\n    top: '7vh',\n    left: '50vw',\n    transform: 'translateX(-25vw)',\n  };\n}\n\nconst useStyles = makeStyles((theme) => ({\n  paper: {\n    position: 'fixed',\n    width: '50vw',\n    height: '80vh',\n    backgroundColor: theme.palette.background.paper,\n    border: 'none',\n    borderRadius: '20px',\n    boxShadow: theme.shadows[5],\n    padding: theme.spacing(2,4,3),\n    outline: 'none',\n  },\n}));\n\nexport default function CustomModal() {\n  const classes = useStyles();\n  const [modalStyle] = useState(getModalStyle);\n  const [open, setOpen] = useState(false);\n  const [content, setContent] = useState(<div></div>);\n\n  const tdBody = (\n    <div style={modalStyle} className={classes.paper}>\n      <h2 id=\"custom-modal-title\">Technical Details</h2>\n      <p id=\"custom-modal-description\">\n        Under construction.\n      </p>\n    </div>\n  );\n  \n  const htuBody = (\n    <div style={modalStyle} className={classes.paper}>\n      <h2 id=\"custom-modal-title\">How to Use</h2>\n      <p id=\"custom-modal-description\">\n        Under construction.\n      </p>\n    </div>\n  );\n  \n  const handleOpen = (contentType) => {\n    setOpen(true);\n    contentType === \"td\" ? setContent(tdBody) : setContent(htuBody);\n  };\n\n  const handleClose = () => {\n    setOpen(false);\n  };\n\n  return (\n    <div id=\"link-container\">\n      <div className=\"link\" onClick={() => handleOpen(\"td\")}>Technical Details</div>\n      <div className=\"link\" onClick={() => handleOpen(\"htu\")}>How to Use</div>\n      <Modal\n        open={open}\n        onClose={handleClose}\n        aria-labelledby=\"custom-modal-title\"\n        aria-describedby=\"custom-modal-description\"\n      >\n        {content}\n      </Modal>\n    </div>\n  );\n}","/home/ben/Desktop/Chesapeake/src/data.js",[],"/home/ben/Desktop/Chesapeake/src/components/Map.js",["69","70"],"/home/ben/Desktop/Chesapeake/src/App.js",["71","72","73","74"],"/home/ben/Desktop/Chesapeake/src/reportWebVitals.js",[],"/home/ben/Desktop/Chesapeake/src/components/Chart.js",["75"],"/home/ben/Desktop/Chesapeake/src/contexts/CurrentContext.js",[],"/home/ben/Desktop/Chesapeake/src/index.js",[],["76","77"],"/home/ben/Desktop/Chesapeake/src/components/Options.js",["78","79","80"],"/home/ben/Desktop/Chesapeake/src/components/Legend.js",["81"],"/home/ben/Desktop/Chesapeake/src/contexts/OptionsContext.js",[],"/home/ben/Desktop/Chesapeake/src/components/Search.js",["82","83","84","85","86"],"/home/ben/Desktop/Chesapeake/src/components/Header.js",["87","88"],"/home/ben/Desktop/Chesapeake/src/contexts/ChartContext.js",[],"/home/ben/Desktop/Chesapeake/src/components/Footer.js",[],"/home/ben/Desktop/Chesapeake/src/components/Favorites.js",[],{"ruleId":"89","severity":1,"message":"90","line":1,"column":27,"nodeType":"91","messageId":"92","endLine":1,"endColumn":36},{"ruleId":"93","severity":1,"message":"94","line":401,"column":6,"nodeType":"95","endLine":401,"endColumn":12,"suggestions":"96"},{"ruleId":"89","severity":1,"message":"97","line":526,"column":10,"nodeType":"91","messageId":"92","endLine":526,"endColumn":15},{"ruleId":"89","severity":1,"message":"98","line":1,"column":19,"nodeType":"91","messageId":"92","endLine":1,"endColumn":29},{"ruleId":"89","severity":1,"message":"90","line":1,"column":31,"nodeType":"91","messageId":"92","endLine":1,"endColumn":40},{"ruleId":"89","severity":1,"message":"99","line":12,"column":9,"nodeType":"91","messageId":"92","endLine":12,"endColumn":17},{"ruleId":"89","severity":1,"message":"100","line":12,"column":19,"nodeType":"91","messageId":"92","endLine":12,"endColumn":27},{"ruleId":"89","severity":1,"message":"90","line":1,"column":31,"nodeType":"91","messageId":"92","en