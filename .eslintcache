n  // } \n  //process the json files in the public folders and combine them into one data object.\n\n  // useEffect(() => {\n  //   processJson()\n  // }, [])\n\n  return (\n    // <Router>\n      <div className=\"App\">\n        <Header />\n        <div className=\"content\">\n          <OptionsContext.Provider value={{options, setOptions}}>\n          <ChartContext.Provider value={{chart, setChart}}>\n          <CurrentContext.Provider value={{current, setCurrent}}>\n          \n          <Map />\n          <div id=\"grid\">\n            <Options />\n            <Search />\n            <Chart />\n            <Legend />\n          </div>\n          \n            {/* <Switch>\n              <Route path=\"/be99/Chesapeake/map\">\n                <Map />\n                <div id=\"grid\">\n                  <Options />\n                  <Search />\n                  <Chart />\n                </div>\n              </Route>\n              <Route path=\"/be99/Cheasapeake/usage\">\n                <div style={{fontSize: '60px', width: 'fit-content', padding: '60px', margin: '0 auto'}}>Under Construction</div>\n                <div style={{fontSize: '30px', position: 'absolute', right: '230px', top: '150px'}}>Please navigate to a different page</div>\n                <div style={{position: 'absolute', fontSize: '80px', right: '580px', top: '100px', color: 'red'}}>^</div>\n                <div style={{position: 'absolute', fontSize: '80px', right: '340px', top: '100px', color: 'red'}}>^</div>\n              </Route>\n              <Route path=\"/\">\n                <div style={{fontSize: '60px', width: 'fit-content', padding: '60px', margin: '0 auto'}}>Under Construction</div>\n                <div style={{fontSize: '30px', position: 'absolute', right: '40px', top: '150px'}}>Please navigate to a different page</div>\n                <div style={{position: 'absolute', fontSize: '80px', right: '350px', top: '100px', color: 'red'}}>^</div>\n                <div style={{position: 'absolute', fontSize: '80px', right: '80px', top: '100px', color: 'red'}}>^</div>\n              </Route>\n            </Switch> */}\n          </CurrentContext.Provider>\n          </ChartContext.Provider>\n          </OptionsContext.Provider>\n        </div>\n        <Footer />\n      </div>\n    // </Router>\n  )\n}\n\nexport default App;\n\n\n\n// TODO:\n\n// secure api key with .env and url restriction\n// set up mapbox account for app and use it's key for production\n// above means migrating styles and tilesets\n// table that has all of the county adjustments in alphabetical order by county, and when you click on the county it opens that table and scrolls to it / highlights it","/home/ben/Desktop/Chesapeake/src/reportWebVitals.js",[],"/home/ben/Desktop/Chesapeake/src/components/Chart.js",["72"],"/home/ben/Desktop/Chesapeake/src/contexts/CurrentContext.js",[],"/home/ben/Desktop/Chesapeake/src/index.js",[],"/home/ben/Desktop/Chesapeake/src/components/Options.js",["73","74","75"],"/home/ben/Desktop/Chesapeake/src/components/Legend.js",[],"/home/ben/Desktop/Chesapeake/src/contexts/OptionsContext.js",[],"/home/ben/Desktop/Chesapeake/src/components/Search.js",["76","77","78","79","80"],"/home/ben/Desktop/Chesapeake/src/components/Header.js",["81","82"],"/home/ben/Desktop/Chesapeake/src/contexts/ChartContext.js",[],"/home/ben/Desktop/Chesapeake/src/components/Footer.js",[],{"ruleId":"83","severity":1,"message":"84","line":1,"column":27,"nodeType":"85","messageId":"86","endLine":1,"endColumn":36},{"ruleId":"83","severity":1,"message":"87","line":2,"column":21,"nodeType":"85","messageId":"86","endLine":2,"endColumn":38},{"ruleId":"88","severity":1,"message":"89","line":366,"column":6,"nodeType":"90","endLine":366,"endColumn":12,"suggestions":"91"},{"ruleId":"83","severity":1,"message":"92","line":490,"column":10,"nodeType":"85","messageId":"86","endLine":490,"endColumn":15},{"ruleId":"83","severity":1,"message":"93","line":1,"column":19,"nodeType":"85","messageId